--- a/fs/ext4/file.c
+++ b/fs/ext4/file.c
@@ -687,14 +687,27 @@
 }
 #endif
 
+/*
+ * determinismo: a module may shorten a buffered write (det_guest.ko's file_error fault, short
+ * writes: a regular file's write moving fewer bytes than asked, as a filling disk makes it).
+ * Given the write's size it returns how much of it to write: all of it, or fewer, at least 1.
+ * Unset, and nothing changes.
+ */
+size_t (*det_write_size)(struct file *file, size_t count) __read_mostly;
+EXPORT_SYMBOL_GPL(det_write_size);
+
 static ssize_t
 ext4_file_write_iter(struct kiocb *iocb, struct iov_iter *from)
 {
 	struct inode *inode = file_inode(iocb->ki_filp);
+	size_t (*size)(struct file *file, size_t count) = READ_ONCE(det_write_size);
 
 	if (unlikely(ext4_forced_shutdown(inode->i_sb)))
 		return -EIO;
 
+	if (size && !(iocb->ki_flags & IOCB_DIRECT) && iov_iter_count(from) > 1)
+		iov_iter_truncate(from, size(iocb->ki_filp, iov_iter_count(from)));
+
 #ifdef CONFIG_FS_DAX
 	if (IS_DAX(inode))
 		return ext4_dax_write_iter(iocb, from);
