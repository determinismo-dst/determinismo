+/* The renamed file's det_rename event: its dentry, moved, names the destination. */
+static noinline void det_trace_rename(struct dentry *dentry, struct inode *inode,
+				      const char *from, bool replaced)
+{
+	char *buffer = __getname();
+	char *cgroup = __getname();
+	char *path;
+
+	if (buffer && cgroup) {
+		path = dentry_path_raw(dentry, buffer, PATH_MAX);
+		if (!IS_ERR(path))
+			trace_det_rename(inode, from, path, det_cgroup_path(cgroup, PATH_MAX),
+					 replaced);
+	}
+	if (cgroup)
+		__putname(cgroup);
+	if (buffer)
+		__putname(buffer);
+}
