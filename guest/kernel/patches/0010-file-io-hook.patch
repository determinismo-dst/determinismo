+/*
+ * determinismo: a module may fail a regular file's read or write before it moves any data
+ * (det_guest.ko's file_error fault: ENOSPC, EDQUOT, EIO, as a full or failing disk returns
+ * them). Called for every read and write of a regular file (their p- and v- forms, splice,
+ * sendfile, copy_file_range, io_uring's), in the task's context; a non-zero return is the
+ * call's result. Unset, and nothing changes.
+ */
+int (*det_file_io)(int read_write, struct file *file) __read_mostly;
+EXPORT_SYMBOL_GPL(det_file_io);
+
 int rw_verify_area(int read_write, struct file *file, const loff_t *ppos, size_t count)
 {
 	int mask = read_write == READ ? MAY_READ : MAY_WRITE;
