@@ -552,6 +552,7 @@ structure LivenessCheckConfig where
 declare_command_config_elab elabLivenessCheckConfig LivenessCheckConfig
 
 declare_command_config_elab elabSimulateConfig ModelChecker.Simulation.SimulateConfig
+declare_command_config_elab elabReplayConfig ModelChecker.Simulation.ReplayConfig
 
 /--
 Check whether a particular config field was written explicitly in the command syntax.
@@ -906,6 +907,24 @@ private def elabSimulateCommandConfig (cfgStx : Syntax)
   let seed ← liftIO <| if cfg0.seed == 0 then IO.rand 0 0xFFFFFFFFFFFFFFFF else pure cfg0.seed
   return { cfg0 with numTraces, maxSteps, seed }
 
+private def mkReplayCall (em : ExecutableModule) (instantiation theoryTerm : Term)
+    (cfg : ModelChecker.Simulation.ReplayConfig) : CommandElabM Term := do
+  let cfgTerm ← `($(mkIdent ``Veil.ModelChecker.Simulation.ReplayConfig.mk) $(quote cfg.file))
+  let runtimeCallExpr ← mkExecutionCall em {} instantiation theoryTerm fun ectx =>
+    `(($(mkIdent ``Veil.ModelChecker.Simulation.replayWithProgress)
+        $(ectx.sysWithoutLog) $(ectx.searchParams) $(ectx.theoryArg) $cfgTerm : _ → _ → IO _))
+  let resultIdent := mkVeilImplementationDetailIdent `replayRuntimeResult
+  `(fun (_ : Option Veil.ModelChecker.ParallelConfig)
+      (progressInstanceId : Nat) (cancelToken : IO.CancelToken) (finish : Lean.Json → IO _) => do
+    let $resultIdent ← ($runtimeCallExpr progressInstanceId cancelToken)
+    finish ($(mkIdent ``Veil.ModelChecker.Simulation.SimulateResult.toDisplayJson) $resultIdent))
+
+@[command_elab Veil.replay, incremental]
+def elabReplay : CommandElab :=
+  elabExecutionCommand "replay" `veil.perf.elaborator.simulate .simulate
+    (fun stx => elabReplayConfig stx[4]) 5 fun ecctx => do
+    return (← mkReplayCall ecctx.executable ecctx.instantiation ecctx.theory ecctx.config, none)
+
 @[command_elab Veil.simulate, incremental]
 def elabSimulate : CommandElab :=
   elabExecutionCommand "simulate" `veil.perf.elaborator.simulate .simulate
