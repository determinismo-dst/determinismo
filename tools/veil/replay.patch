@@ -636,4 +636,14 @@ For a module without abstract types or immutable fields:
 -/
 scoped syntax (name := simulate) "#simulate " (modelCheckMode)? term:max (term:max)? Parser.Tactic.optConfig (assumptionsHoldBy)? : command
 
+/-- Replays a run given as its actions' labels (`(file := "<path>")`: a JSON array of labels, each an
+action's name and arguments as traces display them) through the module's instance, from its initial
+states, keeping at each step the successors whose label matches: a violation
+`replay_refused_at_<k>` at the first label no successor matches, a safety failure at the first state
+that breaks a property, none when every label was taken. Its result is `#simulate`'s (one trace), and
+a JSON line `{"replay": {"labels", "taken", "refused"}}` on standard output. For checking a real
+system's run against the module (determinismo's `determinismo veil`), as a model checker's
+counterexample is checked against the system the other way. -/
+scoped syntax (name := replay) "#replay " (modelCheckMode)? term:max (term:max)? Parser.Tactic.optConfig (assumptionsHoldBy)? : command
+
 end Veil
