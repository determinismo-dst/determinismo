; SPDX-License-Identifier: MIT
; determinismo from jank: libdeterminismo's functions (docs/SDKS.md), its header included and the
; library linked by determinismo-sys; jank converts its strings, numbers and booleans to the C
; types itself. As Clojure's determinismo.workload has them: decisions, events, assertions,
; faults.
(ns determinismo.core
  (:require [clojure.string :as string])
  (:include "libdeterminismo.h"))

(def ^:private hex-digits "0123456789abcdef")

(defn- json-char
  "A character as it is inside a JSON string: quotes, backslashes and control characters (a
  board's newlines) escaped, as the Clojure SDK's json-string does."
  [c]
  (let [n (int c)]
    (cond
      (= c \") "\\\""
      (= c \\) "\\\\"
      (= c \newline) "\\n"
      (= c \return) "\\r"
      (= c \tab) "\\t"
      (and (>= n 0) (< n 32)) (str "\\u00" (nth hex-digits (quot n 16)) (nth hex-digits (mod n 16)))
      :else (str c))))

(defn- json-string [s]
  (str "\"" (apply str (map json-char (str s))) "\""))

(defn ->json
  "A value as JSON: maps (keyword or string keys), vectors and lists, strings, keywords, numbers,
  booleans, nil."
  [value]
  (cond
    (map? value) (str "{" (string/join "," (map (fn [[k v]] (str (json-string (if (keyword? k) (name k) k)) ":" (->json v))) value)) "}")
    (sequential? value) (str "[" (string/join "," (map ->json value)) "]")
    (string? value) (json-string value)
    (keyword? value) (json-string (name value))
    (nil? value) "null"
    :else (str value)))

(defn random-below
  "A uniformly random integer in [0, n): a platform decision (strategies steer it, replays repeat
  it)."
  [n]
  (cpp/det_random_below n))

(defn random-below-named
  "random-below, named for strategies (\"retry.jitter-ms\")."
  [decision n]
  (let [decision (str decision)]
    (cpp/det_random_below_named decision (count decision) n)))

(defn swarm-index
  "An index below n (64 at most) by swarm testing, where random-below drew uniformly: the
  options this timeline keeps for the name, weighted, repeated in runs (the Zig SDK's
  swarm_index)."
  [decision n]
  (let [decision (str decision)]
    (cpp/det_swarm_index decision (count decision) n)))

(defn random-near
  "A value up to max drawn around a limit the workload declares: half the time uniform, else one
  of the limit's edges (0, 1, limit - 1, limit, limit + 1, twice it), named decisions."
  [decision limit max]
  (let [decision (str decision)]
    (cpp/det_random_near decision (count decision) limit max)))

(defn event
  "A structured event, in the run's events (the Logs Explorer)."
  ([name] (event name {}))
  ([name details]
   (let [name (str name)
         json (->json details)]
     (cpp/det_event name (count name) json (count json)))))

(defn- assertion [kind condition message details]
  (let [json (->json details)]
    (cpp/det_assert kind (count kind) (boolean condition) message (count message) json (count json))))

(defn always
  "Holds every time it is evaluated: a property of the run."
  ([condition message] (always condition message {}))
  ([condition message details] (assertion "always" condition message details)))

(defn sometimes
  "Holds at least once over the run."
  ([condition message] (sometimes condition message {}))
  ([condition message details] (assertion "sometimes" condition message details)))

(defn fault
  "A fault now, as a scenario asks for one: {:kind \"pause\" :node \"db\" :duration_ns 1000000000}
  (libdeterminismo's det_fault)."
  [request]
  (let [json (->json request)]
    (cpp/det_fault json (count json))))

(defn describe
  "A test program's --describe: its definition (JSON, as Zig's System) checked and converted by
  libdeterminismo, printed on standard output; negative when refused."
  [definition-json]
  (cpp/det_describe definition-json (count definition-json)))

(defn stop-faults
  "A quiet period: no fault for duration-ns of virtual time."
  [duration-ns]
  (cpp/det_stop_faults duration-ns))

;; The runner, decisions and sleeps, as Clojure's determinismo.workload has them: what a walk is
;; made of (a node's lifecycle, its links, a command in it; a hold, through the runner's
;; sessions). libdeterminismo's det_runner and det_runner_reply; the replies' few fields read in
;; C++ (an id, a line, a status, an output), handed to jank as strings and numbers.

(cpp/raw "
#include <cstdint>
#include <dlfcn.h>
#include <string>

/* det_runner and det_runner_reply looked up as they are first called (the program's own
   libdeterminismo, loaded with it): jank's JIT, which evaluates the namespaces as it compiles
   them, links C++ here against no library, so a direct call missed their symbols there. */
std::string determinismo_runner(std::string const &request) {
  using runner_fn = int32_t (*)(const char *, size_t);
  using reply_fn = uint64_t (*)(uint8_t *, size_t);
  static runner_fn runner = reinterpret_cast<runner_fn>(dlsym(RTLD_DEFAULT, \"det_runner\"));
  static reply_fn reply_of = reinterpret_cast<reply_fn>(dlsym(RTLD_DEFAULT, \"det_runner_reply\"));
  if (runner == nullptr || reply_of == nullptr) return std::string();
  if (runner(request.data(), request.size()) != 0) return std::string();
  std::string reply(65536, '\\0');
  uint64_t size = reply_of(reinterpret_cast<uint8_t *>(reply.data()), reply.size());
  if (size > reply.size()) {
    reply.assign(size, '\\0');
    size = reply_of(reinterpret_cast<uint8_t *>(reply.data()), reply.size());
  }
  reply.resize(size < reply.size() ? size : reply.size());
  return reply;
}

static size_t determinismo_field_at(std::string const &json, std::string const &key) {
  std::string pattern = \"\\\"\" + key + \"\\\":\";
  size_t at = json.find(pattern);
  if (at == std::string::npos) return std::string::npos;
  at += pattern.size();
  while (at < json.size() && json[at] == ' ') at++;
  return at < json.size() ? at : std::string::npos;
}

static void determinismo_utf8(std::string &out, unsigned v) {
  if (v < 0x80) {
    out += char(v);
  } else if (v < 0x800) {
    out += char(0xC0 | (v >> 6));
    out += char(0x80 | (v & 0x3F));
  } else {
    out += char(0xE0 | (v >> 12));
    out += char(0x80 | ((v >> 6) & 0x3F));
    out += char(0x80 | (v & 0x3F));
  }
}

/* A reply's string field, its escapes decoded; \"\" when absent or not a string. */
std::string determinismo_field_string(std::string const &json, std::string const &key) {
  size_t at = determinismo_field_at(json, key);
  if (at == std::string::npos || json[at] != '\"') return std::string();
  std::string out;
  at++;
  while (at < json.size() && json[at] != '\"') {
    char c = json[at++];
    if (c != '\\\\' || at >= json.size()) {
      out += c;
      continue;
    }
    char e = json[at++];
    switch (e) {
    case 'n': out += '\\n'; break;
    case 't': out += '\\t'; break;
    case 'r': out += '\\r'; break;
    case 'b': out += '\\b'; break;
    case 'f': out += '\\f'; break;
    case 'u':
      if (at + 4 <= json.size()) {
        determinismo_utf8(out, unsigned(std::stoul(json.substr(at, 4), nullptr, 16)));
        at += 4;
      }
      break;
    default: out += e;
    }
  }
  return out;
}

/* A reply's integer field; -1 when absent. */
int64_t determinismo_field_int(std::string const &json, std::string const &key) {
  size_t at = determinismo_field_at(json, key);
  if (at == std::string::npos || !(json[at] == '-' || (json[at] >= '0' && json[at] <= '9'))) return -1;
  return std::stoll(json.substr(at));
}

/* Whether a reply's field is a string (not null, not absent). */
bool determinismo_field_is_string(std::string const &json, std::string const &key) {
  size_t at = determinismo_field_at(json, key);
  return at != std::string::npos && json[at] == '\"';
}
")

(defn- words [argv] (mapv #(if (keyword? %) (name %) (str %)) argv))

(defn runner
  "A command run by the guest's runner, which sees every node (det-nodes start, stop, kill, crash,
  pause, link, exec, hold; the network, the disks), from this program in its node: argv as
  words. {:status :stdout :stderr}, each request a runner_request event."
  [argv]
  (let [reply (cpp/determinismo_runner (->json {:argv (words argv)}))]
    {:status (cpp/determinismo_field_int reply "status")
     :stdout (cpp/determinismo_field_string reply "stdout")
     :stderr (cpp/determinismo_field_string reply "stderr")}))

(defn node!
  "A node's lifecycle, from any node: action :start, :stop, :kill, :crash (a power loss), :wipe,
  :pause or :resume."
  [action node]
  (runner ["det-nodes" action node]))

(defn link!
  "The link between two nodes (or a node and \"runner\"): :up or :down."
  [a b state]
  (runner ["det-nodes" "link" a b state]))

(defn node-exec
  "A command in another node, as docker exec: {:status :stdout :stderr}."
  [node & argv]
  (runner (into ["det-nodes" "exec" node] argv)))

(defn session
  "A runner command that outlives one request (det-runner's sessions: det-nodes hold, a tail),
  opened: its id, for session-read, session-write and session-close."
  [argv]
  (cpp/determinismo_field_int (cpp/determinismo_runner (->json {:argv (words argv) :session "open"})) "session"))

(defn session-read
  "A session's next line of output; nil at its end."
  [id]
  (let [reply (cpp/determinismo_runner (->json {:session "read" :id id}))]
    (when (cpp/determinismo_field_is_string reply "line")
      (cpp/determinismo_field_string reply "line"))))

(defn session-write
  "Writes input to a session's command and sends it signal (\"USR1\", \"TERM\", ... or nil)."
  [id input signal]
  (cpp/determinismo_runner (->json (cond-> {:session "write" :id id}
                                     input (assoc :input input)
                                     signal (assoc :signal signal)))))

(defn session-close
  "Signals a session's command (TERM) and forgets it."
  [id]
  (cpp/determinismo_runner (->json {:session "close" :id id :signal "TERM"})))

(defn hold
  "Holds threads of a node's process where points say (det-nodes hold: a function, then --caller,
  --arg, --repeat, --every, --direct, --and <function> ...), as the Zig SDK's Node.hold, armed
  before it returns: {:session :armed}; then held?, release-point, release."
  [node points timeout-ms]
  (let [id (session (concat ["det-nodes" "hold" (name node)] points ["--timeout-ms" (str timeout-ms)]))
        line (session-read id)]
    {:session id :armed (boolean (and line (string/starts-with? line "{\"armed\":")))}))

(defn held?
  "Waits until a thread is held at point (0, 1, ...): true, or false when none will be."
  [{:keys [session]} point]
  (loop [line (session-read session)]
    (cond
      (or (nil? line) (string/starts-with? line "{\"held\":null")) false
      (and (string/starts-with? line "{\"held\":") (string/ends-with? line (str "\"point\":" point "}"))) true
      :else (recur (session-read session)))))

(defn release-point
  "Lets point's held thread go on, the others held still."
  [{:keys [session]} point]
  (session-write session (str "release " point "\n") "USR1"))

(defn release
  "Lets every held thread go and ends the hold."
  [{:keys [session]}]
  (session-close session))

(defn field-string
  "A JSON object's string field (a reply's), its escapes decoded; \"\" when absent or not a
  string."
  [json key]
  (cpp/determinismo_field_string json (name key)))

(defn field-int
  "A JSON object's non-negative integer field (a term, an index, a status); nil when absent,
  negative or not an integer."
  [json key]
  (let [value (cpp/determinismo_field_int json (name key))]
    (when-not (neg? value) value)))

(defn decide
  "One of options, a named decision (strategies steer it, replays repeat it)."
  [decision options]
  (let [decision (str decision)
        lines (string/join "\n" (map str options))]
    (nth options (cpp/det_decide decision (count decision) lines (count lines)))))

(defn sleep-ms
  "Sleeps ms of virtual time."
  [ms]
  (cpp/det_sleep_ms ms))
