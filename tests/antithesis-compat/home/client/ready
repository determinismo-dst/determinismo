#!/bin/sh
# SPDX-License-Identifier: MIT
# The HOME the node's start command got in its environment (what a child of it inherits), kept for
# the test command; then the setup is complete at once (an Antithesis SDK's line, in the node's
# output sink).
env | sed -n 's/^HOME=//p' > /tmp/start-home
printf '%s\n' '{"antithesis_setup":{"status":"complete","details":null}}' >> "$ANTITHESIS_OUTPUT_DIR/setup.jsonl"
exec sleep infinity
