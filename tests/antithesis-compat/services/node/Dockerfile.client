# SPDX-License-Identifier: MIT
# The client's image, with the test template (one container holds it).
FROM docker.io/library/redis:7.4-alpine
COPY ask ready /usr/local/bin/
COPY tests/ /opt/antithesis/test/v1/services/
RUN chmod 0755 /usr/local/bin/ask /usr/local/bin/ready /opt/antithesis/test/v1/services/singleton_driver_services.sh
