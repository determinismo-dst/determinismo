#!/bin/sh
# SPDX-License-Identifier: MIT
# The HOSTNAME the node's start command got in its environment (what a child of it inherits, not
# the shell's own variable: bash and busybox's sh set one from the hostname without exporting it),
# kept for the test command; then the setup is complete at once (an Antithesis SDK's line, in the
# node's output sink).
env | sed -n 's/^HOSTNAME=//p' > /tmp/start-hostname
printf '%s\n' '{"antithesis_setup":{"status":"complete","details":null}}' >> "$ANTITHESIS_OUTPUT_DIR/setup.jsonl"
exec sleep infinity
