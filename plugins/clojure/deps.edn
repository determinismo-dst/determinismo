;; SPDX-License-Identifier: MIT
;; The strategy host on the JVM: `clojure -M -m strategies [options]` from this directory
;; (strategies.clj), its nREPL on 1667 by default.
{:paths ["."]
 :deps {determinismo/client {:local/root "../../clients/clojure"}
        org.clojure/clojure {:mvn/version "1.12.0"}
        nrepl/nrepl {:mvn/version "1.3.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.babashka/http-client {:mvn/version "0.4.22"}
        ;; Ended timelines' events are zstd (src/event_files.zig): `timeline` reads them.
        com.github.luben/zstd-jni {:mvn/version "1.5.6-9"}}
 ;; The host's own tests: `clojure -M:test` (strategies_test.clj, Jev stubbed).
 :aliases {:test {:main-opts ["-m" "strategies-test"]}}}
