;; SPDX-License-Identifier: MIT
;; The visualization's process: the window of cards (jankifier/cards: jank's nREPL server on a
;; thread of its own, its port in .nrepl-port, the window's frames on the main thread) with
;; determinismo's cards and the moment lab's. A REPL connected to it uses determinismo.api,
;; determinismo.debug, determinismo.lab and determinismo.lean as anywhere, and the window follows.
;;   ./viz.sh                                     the window
;;   ./viz.sh --hidden --record <video.mp4>       its frames to a video, nothing shown
(ns determinismo.viz.main
  (:require [cards.main :as main]
            [determinismo.viz :as viz]
            [determinismo.viz.lab]))

(defn -main [& args]
  (viz/listen!)
  ;; The viz's own calls (a card by hand, a script asking it) make no card of their own.
  (main/quiet! "determinismo.viz/")
  (main/run! (assoc (main/options args) :title "determinismo")))
