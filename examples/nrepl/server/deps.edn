;; SPDX-License-Identifier: MIT
;; An nREPL server (the version under test), listening for the test program's clients.
{:deps {nrepl/nrepl {:mvn/version "1.8.0"}}
 :aliases {:server {:main-opts ["-m" "nrepl.cmdline" "--port" "7888" "--bind" "0.0.0.0"]}
           ;; The same server with cider-nrepl's middleware, as CIDER and Calva start it.
           :cider {:extra-deps {cider/cider-nrepl {:mvn/version "0.64.1"}}
                   :main-opts ["-m" "nrepl.cmdline" "--port" "7888" "--bind" "0.0.0.0"
                               "--middleware" "[cider.nrepl/cider-middleware]"]}}}
