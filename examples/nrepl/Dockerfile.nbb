# SPDX-License-Identifier: MIT
# nbb 1.6.214 (EPL-1.0, Babashka's ClojureScript on Node.js) serving nREPL with its own server:
# proof's matrix has it (its `nbb` profile). No interrupt op: scenario `basic`. No coverage.
FROM docker.io/library/node:22-alpine
RUN npm install -g nbb@1.6.214
ENTRYPOINT ["nbb", "nrepl-server", ":port", "7888", ":host", "0.0.0.0"]
