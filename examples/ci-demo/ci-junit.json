{
  "compose": "compose.yaml",
  "node": "app",
  "setup": "cd /app && python -m pytest --version",
  "list": "cd /app && python -m pytest --collect-only -q | grep '::'",
  "run": "cd /app && python -m pytest -q -p no:cacheprovider --junitxml /tmp/junit.xml {tests}",
  "junit": "/tmp/junit.xml",
  "shards": 1,
  "timelines": 12,
  "key_files": ["tests", "Dockerfile"]
}
